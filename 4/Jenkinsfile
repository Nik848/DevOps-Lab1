pipeline {
    agent any

    triggers {
        pollSCM('* * * * *')
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building application...'

                sh '''
                    rm -rf build
                    mkdir -p build
                    cp 4/app/index.html build/index.html
                '''
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application...'

                sh '''
                    test -f build/index.html
                    grep -q "CI/CD" build/index.html
                '''
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging application...'

                sh '''
                    tar -czf application.tar.gz -C build index.html
                '''
            }
        }

        stage('Archive Artifact') {
            steps {
                echo 'Archiving build artifact...'

                archiveArtifacts artifacts: 'application.tar.gz',
                                 fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'

                sh '''
                    rm -rf /tmp/cicd-deployment
                    mkdir -p /tmp/cicd-deployment
                    tar -xzf application.tar.gz -C /tmp/cicd-deployment
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'

                sh '''
                    test -f /tmp/cicd-deployment/index.html
                    grep -q "CI/CD" /tmp/cicd-deployment/index.html
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD workflow completed successfully.'
        }

        failure {
            echo 'CI/CD workflow failed.'
        }
    }
}